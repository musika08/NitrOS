<Window
    x:Class="NitrOS.App.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NitrOS">

    <Grid Background="{StaticResource CockpitWindowBrush}">
        <Grid.ColumnDefinitions>
            <!-- Icon rail: 64 px collapsed, 200 px expanded -->
            <ColumnDefinition Width="64" x:Name="SidebarColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0F1218"
                BorderBrush="{StaticResource CockpitStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Brand and expand toggle -->
                <Grid Grid.Row="0" Height="40" x:Name="SidebarTitleArea" Margin="8,4,8,0">
                    <Button x:Name="RailToggle"
                            Style="{StaticResource RailButton}"
                            Click="OnRailToggleClicked"
                            AutomationProperties.Name="Expand or collapse the menu">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource CockpitAccentBrush}">
                                <TextBlock Text="&#xE945;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{StaticResource CockpitOnAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="BrandLabel" Text="NitrOS" Visibility="Collapsed"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource CockpitTextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="2" Margin="8,8,8,0">
                    <Button x:Name="NavOverview" Style="{StaticResource RailButton}" Click="OnNavOverviewClicked" AutomationProperties.Name="Overview">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelOverview" Text="Overview" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavTune" Style="{StaticResource RailButton}" Click="OnNavTuneClicked" AutomationProperties.Name="Tuning Profiles">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelTune" Text="Tuning Profiles" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavUpdates" Style="{StaticResource RailButton}" Click="OnNavUpdatesClicked" AutomationProperties.Name="Device Updates">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelUpdates" Text="Device Updates" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHealth" Style="{StaticResource RailButton}" Click="OnNavHealthClicked" AutomationProperties.Name="System Health">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE95E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelHealth" Text="System Health" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavUndo" Style="{StaticResource RailButton}" Click="OnNavUndoClicked" AutomationProperties.Name="Undo Changes">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelUndo" Text="Undo Changes" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavMyths" Style="{StaticResource RailButton}" Click="OnNavMythsClicked" AutomationProperties.Name="Myths Tested">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelMyths" Text="Myths Tested" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Padding="8,8" BorderBrush="{StaticResource CockpitStrokeBrush}" BorderThickness="0,1,0,0">
                    <Button x:Name="NavSettings" Style="{StaticResource RailButton}" Click="OnNavSettingsClicked" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabelSettings" Text="Settings" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Main area: 40 px title strip, then the page frame -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    x:Name="TitleBarArea"
                    Height="40"
                    Padding="12,0"
                    BorderBrush="{StaticResource CockpitStrokeBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{StaticResource CockpitWindowBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Content="&#xE72B;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Width="32" Height="32" MinHeight="32"
                                Padding="0"
                                CornerRadius="16"
                                Visibility="Collapsed"
                                Click="OnBackClicked"
                                AutomationProperties.Name="Back" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Overview"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CockpitTextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Column="1" x:Name="DragRegion" Background="Transparent" />
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
