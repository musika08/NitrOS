<Window
    x:Class="NitrOS.App.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NitrOS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Apple macOS-style compact 44px navigation bar with subtle bottom border -->
        <Border x:Name="TitleBarArea"
                Height="44"
                Padding="16,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorAltBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Button x:Name="BackButton"
                        Content="&#xE72B;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Width="32" Height="32"
                        Padding="0"
                        CornerRadius="16"
                        Visibility="Collapsed"
                        Click="OnBackClicked" />
                <TextBlock Text="NitrOS"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Frame x:Name="ContentFrame"
               Grid.Row="1" />
    </Grid>
</Window>
