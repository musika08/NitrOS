<Window
    x:Class="NitrOS.App.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NitrOS">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- macOS-style Left Sidebar -->
            <ColumnDefinition Width="230" x:Name="SidebarColumn" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar (macOS System Settings Style) -->
        <Border Grid.Column="0"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Sidebar App Brand / Title Area -->
                <Grid Grid.Row="0" Height="44" Padding="16,0" x:Name="SidebarTitleArea">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#007AFF">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="NitrOS"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Sidebar Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="3" Padding="10,6">
                        <!-- Overview / Start -->
                        <Button x:Name="NavOverview"
                                Click="OnNavOverviewClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#0A84FF">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Overview"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tune PC -->
                        <Button x:Name="NavTune"
                                Click="OnNavTuneClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#007AFF">
                                    <TextBlock Text="&#xE790;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Tuning Profiles"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Device Updates -->
                        <Button x:Name="NavUpdates"
                                Click="OnNavUpdatesClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#AF52DE">
                                    <TextBlock Text="&#xE895;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Device Updates"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- System Health -->
                        <Button x:Name="NavHealth"
                                Click="OnNavHealthClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#34C759">
                                    <TextBlock Text="&#xE95E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="System Health"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Undo Changes -->
                        <Button x:Name="NavUndo"
                                Click="OnNavUndoClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#FF9500">
                                    <TextBlock Text="&#xE7A7;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Undo Changes"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Myths Tested -->
                        <Button x:Name="NavMyths"
                                Click="OnNavMythsClicked"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#FF2D55">
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Myths Tested"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Bottom: Settings -->
                <Border Grid.Row="2"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8">
                    <Button x:Name="NavSettings"
                            Click="OnNavSettingsClicked"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,6"
                            CornerRadius="8"
                            BorderThickness="0"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#8E8E93">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Settings"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Main Detail Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- macOS-style 44px Top Navigation & Title Bar Drag Region -->
            <Border Grid.Row="0"
                    x:Name="TitleBarArea"
                    Height="44"
                    Padding="14,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Back Button & Breadcrumb Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Content="&#xE72B;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Width="30" Height="30"
                                Padding="0"
                                CornerRadius="15"
                                Visibility="Collapsed"
                                Click="OnBackClicked" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Overview"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Draggable Window Title Region -->
                    <Grid Grid.Column="1" x:Name="DragRegion" Background="Transparent" />
                </Grid>
            </Border>

            <!-- Page Content Frame -->
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
