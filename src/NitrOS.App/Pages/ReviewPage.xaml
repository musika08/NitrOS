<Page
    x:Class="NitrOS.App.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24,20"
                    Spacing="14"
                    HorizontalAlignment="Center">

            <TextBlock Text="Review your changes"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />

            <!-- Safety note -->
            <TextBlock Text="{x:Bind ViewModel.SafetyNote, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.SafetyNote, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Irreversible changes notice -->
            <Border Visibility="{x:Bind ViewModel.IrreversibleWarning, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppleCardCornerRadius}"
                    Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Irreversible changes"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.IrreversibleWarning, Mode=OneWay}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.IrreversibleNames, Mode=OneWay}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dependency warnings -->
            <Border Visibility="{x:Bind ViewModel.DependencyWarnings, Mode=OneWay, Converter={StaticResource HasItemsToVisibilityConverter}}"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppleCardCornerRadius}"
                    Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dependency warnings"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DependencyWarnings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Stops working summary -->
            <Border Visibility="{x:Bind ViewModel.StopsWorking, Mode=OneWay, Converter={StaticResource HasItemsToVisibilityConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppleCardCornerRadius}"
                    Padding="14,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="What stops working"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StopsWorking, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Grouped changes list -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppleCardCornerRadius}"
                    Padding="14,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Switches to apply"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="screens:ReviewGroup">
                                <StackPanel Spacing="3" Margin="0,3">
                                    <TextBlock Text="{x:Bind Group}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{x:Bind Names}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Margin="10,1,0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Unavailable reason banner -->
            <TextBlock Text="{x:Bind ViewModel.GoUnavailableReason, Mode=OneWay}"
                       FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{x:Bind ViewModel.GoUnavailableReason, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                       TextWrapping="Wrap" />

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                <Button x:Name="GoButton"
                        Content="Go"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.Go}"
                        MinWidth="100" />

                <Button Content="Back"
                        Command="{x:Bind ViewModel.Back}"
                        MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
