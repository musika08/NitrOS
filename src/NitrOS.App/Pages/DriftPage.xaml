<Page
    x:Class="NitrOS.App.Pages.DriftPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24"
                    Spacing="16"
                    HorizontalAlignment="Center">

            <TextBlock Text="Settings turned back on"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.PromptText, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Drifted items list -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Turned back on by Windows"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DriftedNames, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Errors / Could not check list -->
            <Border Visibility="{x:Bind ViewModel.CouldNotCheck, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Could not check"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CouldNotCheck, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <Button Content="Turn off again"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.TurnOffAgain}"
                        MinWidth="120" />

                <Button Content="Not now"
                        Command="{x:Bind ViewModel.NotNow}"
                        MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
