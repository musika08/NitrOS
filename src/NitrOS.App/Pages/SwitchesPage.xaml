<Page
    x:Class="NitrOS.App.Pages.SwitchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">



    <Grid XYFocusKeyboardNavigation="Enabled" RowDefinitions="Auto,*,Auto">

        <!-- Top strip: profile chip, search, myths -->
        <Border Grid.Row="0"
                Background="#0F1218"
                BorderBrush="{StaticResource CockpitStrokeBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,8">
            <Grid MaxWidth="{StaticResource ContentColumnMaxWidth}"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CardText, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource CockpitChip}">
                        <TextBlock Text="{x:Bind ViewModel.CardStatusText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CockpitTextSecondary}" />
                    </Border>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         PlaceholderText="Search switches"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Content="Myths we tested"
                        Command="{x:Bind ViewModel.OpenMyths}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Switch groups -->
        <ScrollViewer Grid.Row="1" Padding="24,4">
            <Grid>
            <ItemsRepeater x:Name="GroupsList"
                           MaxWidth="{StaticResource ContentColumnMaxWidth}"
                           HorizontalAlignment="Stretch"
                           ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="screens:SwitchGroupView">
                        <StackPanel Margin="0,10,0,4" Spacing="4">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="4,0,0,2" />

                            <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="screens:SwitchRow">
                                        <Border Style="{StaticResource CockpitRow}" Margin="0,2" Padding="14,0,6,0" MinHeight="48">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10" MinHeight="48">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource CockpitTextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource CockpitChip}">
                                                            <TextBlock Text="{x:Bind ActionBadge, Mode=OneWay}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource CockpitTextSecondary}" />
                                                        </Border>
                                                        <Border Style="{StaticResource CockpitChip}"
                                                                Background="{StaticResource SystemFillColorCautionBackgroundBrush}"
                                                                Visibility="{x:Bind CantUndoBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Can't undo"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SystemFillColorCautionBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind MemoryText}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentTextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center" />

                                                    <ToggleSwitch Grid.Column="3"
                                                                  IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind IsAvailable}"
                                                                  OnContent="" OffContent=""
                                                                  MinWidth="0"
                                                                  VerticalAlignment="Center" />

                                                    <ToggleButton x:Name="MoreButton"
                                                                  Grid.Column="4"
                                                                  Width="40" Height="40" MinHeight="40"
                                                                  Padding="0"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  AutomationProperties.Name="Show details">
                                                        <TextBlock Text="&#xE70D;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource CockpitTextSecondary}" />
                                                    </ToggleButton>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,8,10"
                                                            Visibility="{Binding IsChecked, ElementName=MoreButton, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind Description}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource CockpitTextSecondary}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{x:Bind ActionDetail, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind RiskBadge}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource CockpitTextTertiary}"
                                                                   Visibility="{x:Bind RiskBadge, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind UnavailableReason}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource SystemFillColorCriticalBrush}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{x:Bind UnavailableReason, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock Text="No switches match your search."
                       FontSize="14"
                       Foreground="{StaticResource CockpitTextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,48,0,0"
                       Visibility="{x:Bind ViewModel.Groups, Mode=OneWay, Converter={StaticResource NoItemsToVisibilityConverter}}" />
            </Grid>
        </ScrollViewer>

        <!-- Bottom bar: live total and Review -->
        <Border Grid.Row="2"
                Background="#0F1218"
                BorderBrush="{StaticResource CockpitStrokeBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid MaxWidth="{StaticResource ContentColumnMaxWidth}"
                  ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}"
                               FontSize="15"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.OnCountText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{StaticResource CockpitTextSecondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Review changes"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.Review}"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
