<Page
    x:Class="NitrOS.App.Pages.SwitchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d">

    <Grid XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <!-- Top pinned header: Search, Card text, Info -->
            <RowDefinition Height="Auto" />
            <!-- Middle scrolling switch list -->
            <RowDefinition Height="*" />
            <!-- Bottom pinned footer: Totals and Review button -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Pinned Area -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Setup:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CardText, Mode=OneWay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ApplePillCornerRadius}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CardStatusText, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Search switches..."
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="Myths we tested"
                            Command="{x:Bind ViewModel.OpenMyths}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Scrolling Switch Groups -->
        <ScrollViewer Grid.Row="1" Margin="24,8">
            <ItemsControl x:Name="GroupsList"
                          MaxWidth="{StaticResource ContentColumnMaxWidth}"
                          HorizontalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:SwitchGroupView">
                        <StackPanel Margin="0,6,0,12">
                            <TextBlock Text="{x:Bind Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,6" />

                            <ItemsControl ItemsSource="{x:Bind Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="screens:SwitchRow">
                                        <Border Margin="0,2"
                                                Padding="14,8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource AppleControlCornerRadius}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{ThemeResource LayerFillColorAltBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource ApplePillCornerRadius}"
                                                                Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ActionBadge, Mode=OneWay}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <Border Visibility="{x:Bind CantUndoBadge, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource ApplePillCornerRadius}"
                                                                Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="Can't undo"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{x:Bind Description}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,1,0,0">
                                                        <TextBlock Text="{x:Bind ActionDetail, Mode=OneWay}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind MemoryText}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{x:Bind RiskBadge}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{x:Bind RiskBadge, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{x:Bind UnavailableReason}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                               Visibility="{x:Bind UnavailableReason, Converter={StaticResource NullToVisibilityConverter}}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <ToggleSwitch Grid.Column="1"
                                                              IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind IsAvailable}"
                                                              VerticalAlignment="Center"
                                                              Margin="16,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Pinned Area -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid MaxWidth="{StaticResource ContentColumnMaxWidth}"
                  HorizontalAlignment="Center"
                  ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.OnCountText, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Review changes"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.Review}"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
