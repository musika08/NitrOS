<Page
    x:Class="NitrOS.App.Pages.SwitchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d">

    <Grid XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <!-- Top pinned header: Search, Card text, Info -->
            <RowDefinition Height="Auto" />
            <!-- Middle scrolling switch list -->
            <RowDefinition Height="*" />
            <!-- Bottom pinned footer: Totals and Review button -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Pinned Area -->
        <Grid Grid.Row="0"
              MaxWidth="{StaticResource ContentColumnMaxWidth}"
              Margin="24,16,24,8"
              ColumnDefinitions="*,Auto">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search switches..."
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Myths we tested"
                    Command="{x:Bind ViewModel.OpenMyths}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Scrolling Switch Groups -->
        <ScrollViewer Grid.Row="1" Margin="24,0">
            <ItemsControl x:Name="GroupsList"
                          MaxWidth="{StaticResource ContentColumnMaxWidth}"
                          HorizontalAlignment="Center"
                          ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:SwitchGroupView">
                        <StackPanel Margin="0,8,0,16">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{x:Bind Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="screens:SwitchRow">
                                        <Border Margin="0,3"
                                                Padding="16,12"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                        <Border Visibility="{x:Bind CantUndoBadge, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4,1">
                                                            <TextBlock Text="Can't undo"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{x:Bind Description}"
                                                               Style="{ThemeResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{x:Bind MemoryText}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{x:Bind RiskBadge}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{x:Bind RiskBadge, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{x:Bind UnavailableReason}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                               Visibility="{x:Bind UnavailableReason, Converter={StaticResource NullToVisibilityConverter}}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <ToggleSwitch Grid.Column="1"
                                                              IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                              IsEnabled="{x:Bind IsAvailable}"
                                                              VerticalAlignment="Center"
                                                              Margin="16,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Pinned Area -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid MaxWidth="{StaticResource ContentColumnMaxWidth}"
                  HorizontalAlignment="Center"
                  ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.OnCountText, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Review changes"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.Review}"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Page>
