<Page
    x:Class="NitrOS.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24,20"
                    Spacing="14"
                    HorizontalAlignment="Center">

            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />

            <Border Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppleCardCornerRadius}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Check after Windows updates"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind ViewModel.CheckAfterUpdates, Mode=OneWay}"
                                  Toggled="OnToggleToggled"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Button Content="Back"
                    Command="{x:Bind ViewModel.Back}"
                    Margin="0,6,0,0"
                    MinWidth="90" />
        </StackPanel>
    </ScrollViewer>
</Page>
