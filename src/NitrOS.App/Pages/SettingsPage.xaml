<Page
    x:Class="NitrOS.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24"
                    Spacing="16"
                    HorizontalAlignment="Center">

            <TextBlock Text="Settings"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <Border Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Check after Windows updates"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind ViewModel.CheckAfterUpdates, Mode=OneWay}"
                                  Toggled="OnToggleToggled"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Button Content="Back"
                    Command="{x:Bind ViewModel.Back}"
                    Margin="0,8,0,0"
                    MinWidth="100" />
        </StackPanel>
    </ScrollViewer>
</Page>
