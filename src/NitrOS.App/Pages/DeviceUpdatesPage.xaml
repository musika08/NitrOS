<Page
    x:Class="NitrOS.App.Pages.DeviceUpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}"
    XYFocusKeyboardNavigation="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24,16"
                    Spacing="10"
                    HorizontalAlignment="Stretch">

            <!-- Header, then actions on their own row so nothing collides at narrow widths -->
            <StackPanel Spacing="3">
                <TextBlock Text="Device updates" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.LastChecked, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckButton"
                        Content="Check updates"
                        Command="{x:Bind ViewModel.CheckCommand, Mode=OneWay}" />
                <Button Content="Update selected"
                        Command="{x:Bind ViewModel.UpdateSelectedCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanUpdateSelected, Mode=OneWay}" />
                <Button Content="Update all"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.UpdateAllCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanUpdateAll, Mode=OneWay}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,2,0,0" />
            <TextBlock Text="{x:Bind ViewModel.CheckProgress, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Policy Note -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.PolicyNote, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                IsClosable="False"
                Severity="Informational"
                CornerRadius="{StaticResource AppleCardCornerRadius}"
                Message="{x:Bind ViewModel.PolicyNote, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.PolicyNote, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Notices -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <InfoBar IsOpen="True"
                                 IsClosable="False"
                                 Severity="Warning"
                                 CornerRadius="{StaticResource AppleCardCornerRadius}"
                                 Message="{x:Bind}"
                                 Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Update Items List -->
            <TextBlock Text="Devices and updates"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,2,0,0" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:UpdateRow">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppleCardCornerRadius}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="12,6"
                                Margin="0,2">
                            <Grid RowSpacing="4" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Selection Checkbox -->
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Visibility="{x:Bind HasAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          MinWidth="24"
                                          Padding="0"
                                          Margin="0,0,2,0"
                                          Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                          VerticalAlignment="Center" />

                                <!-- Title, Kind, State badge -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="{StaticResource ApplePillCornerRadius}"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind KindText}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Up to date badge (Green) -->
                                    <Border Visibility="{x:Bind IsUpToDate, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ApplePillCornerRadius}"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Up to date"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>

                                    <!-- New version badge (Blue) -->
                                    <Border Visibility="{x:Bind IsNewVersion, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="{StaticResource ApplePillCornerRadius}"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="New version"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Blocked badge (Red) -->
                                    <Border Visibility="{x:Bind IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ApplePillCornerRadius}"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Blocked"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Border>

                                    <!-- Utility / Manual badge (Gray) -->
                                    <Border Visibility="{x:Bind IsUtility, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource ApplePillCornerRadius}"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StateText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Install" Command="{x:Bind Install}" Visibility="{x:Bind ShowInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource AccentButtonStyle}" MinHeight="36" Padding="10,2" FontSize="12" />
                                    <Button Content="Get anyway" Command="{x:Bind GetAnyway}" Visibility="{x:Bind ShowGetAnyway, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" MinHeight="36" Padding="10,2" FontSize="12" />
                                    <Button Content="Open page" Command="{x:Bind OpenPage}" Visibility="{x:Bind OpenPage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" MinHeight="36" Padding="10,2" FontSize="12" />
                                    <Button Content="Start updater" Command="{x:Bind StartUpdater}" Visibility="{x:Bind StartUpdater, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Style="{StaticResource AccentButtonStyle}" MinHeight="36" Padding="10,2" FontSize="12" />
                                    <Button Content="Open folder" Command="{x:Bind OpenFolder}" Visibility="{x:Bind OpenFolder, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" MinHeight="36" Padding="10,2" FontSize="12" />
                                </StackPanel>

                                <!-- Versions & Details (Compact comparison) -->
                                <StackPanel Spacing="2" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind InstalledText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind LatestText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind AlsoOfferedText}"
                                               FontSize="10"
                                               Visibility="{x:Bind AlsoOfferedText, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind BlockedReason}"
                                               FontSize="10"
                                               Visibility="{x:Bind BlockedReason, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>

                                <!-- Warning for Firmware -->
                                <TextBlock
                                    Text="Do not turn off your PC while firmware is updating."
                                    Visibility="{x:Bind IsFirmware}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    FontSize="10"
                                    Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" />

                                <!-- Progress & Result -->
                                <StackPanel Spacing="2" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Bind Progress, Mode=OneWay}"
                                               Visibility="{x:Bind Progress, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               FontSize="12" />
                                    <TextBlock Text="{x:Bind Result, Mode=OneWay}"
                                               Visibility="{x:Bind Result, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Unavailable, Mode=OneWay}"
                                               Visibility="{x:Bind Unavailable, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
