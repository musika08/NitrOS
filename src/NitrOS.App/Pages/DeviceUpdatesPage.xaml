<Page
    x:Class="NitrOS.App.Pages.DeviceUpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="32">

            <!-- Top Header & Check Actions -->
            <StackPanel Spacing="8">
                <TextBlock Text="Device updates" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CheckButton" Content="Check for updates" Command="{x:Bind ViewModel.CheckCommand, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.LastChecked, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.CheckProgress, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Policy Note -->
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Message="{x:Bind ViewModel.PolicyNote, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.PolicyNote, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Notices -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{x:Bind}" Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Update Items List -->
            <TextBlock Text="Available updates" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:UpdateRow">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,4">
                            <Grid RowSpacing="8" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Title, Kind, State badge -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind KindText}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <Border Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StateText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="1">
                                    <Button Content="Install" Command="{x:Bind Install}" Visibility="{x:Bind Install, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Get anyway" Command="{x:Bind GetAnyway}" Visibility="{x:Bind GetAnyway, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                    <Button Content="Open page" Command="{x:Bind OpenPage}" Visibility="{x:Bind OpenPage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                    <Button Content="Start updater" Command="{x:Bind StartUpdater}" Visibility="{x:Bind StartUpdater, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Open folder" Command="{x:Bind OpenFolder}" Visibility="{x:Bind OpenFolder, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Versions & Details -->
                                <StackPanel Spacing="4" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Bind InstalledText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind LatestText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind AlsoOfferedText}" Visibility="{x:Bind AlsoOfferedText, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind BlockedReason}" Visibility="{x:Bind BlockedReason, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>

                                <!-- Warning for Firmware -->
                                <TextBlock
                                    Text="Do not turn off your PC while firmware is updating."
                                    Visibility="{x:Bind IsFirmware}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" />

                                <!-- Progress & Result -->
                                <StackPanel Spacing="4" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind Progress, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Result, Mode=OneWay}" Visibility="{x:Bind Result, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Unavailable, Mode=OneWay}" Visibility="{x:Bind Unavailable, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
