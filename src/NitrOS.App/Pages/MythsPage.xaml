<Page
    x:Class="NitrOS.App.Pages.MythsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:help="using:NitrOS.App.Logic.Help"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24"
                    Spacing="16"
                    HorizontalAlignment="Center">

            <TextBlock Text="Myths we tested"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.Intro, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.All, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="help:Myth">
                        <Border Margin="0,4"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Verdict}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind Why}"
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Back"
                    Command="{x:Bind ViewModel.Back}"
                    Margin="0,8,0,0"
                    MinWidth="100" />
        </StackPanel>
    </ScrollViewer>
</Page>
