<Page
    x:Class="NitrOS.App.Pages.CardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24,16"
                    Spacing="12"
                    HorizontalAlignment="Stretch">

            <StackPanel Spacing="2">
                <TextBlock Text="Choose a profile" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.MemoryLine, Mode=OneWay}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CockpitTextSecondary}" />
            </StackPanel>

            <ItemsRepeater x:Name="CardsList" ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="340"
                                       MinColumnSpacing="12"
                                       MinRowSpacing="12"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="screens:CardItem">
                        <Button Style="{StaticResource CockpitCardButton}"
                                Tag="{x:Bind Id}"
                                Click="OnPickClicked"
                                AutomationProperties.Name="{x:Bind Title}">
                            <StackPanel Spacing="6" MaxWidth="300" HorizontalAlignment="Left">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CockpitTextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Border Style="{StaticResource CockpitChip}"
                                                Background="{StaticResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{x:Bind IsInUse, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="In use" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SystemFillColorSuccessBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource CockpitChip}"
                                                Background="{StaticResource CockpitAccentBrush}"
                                                BorderThickness="0"
                                                Visibility="{x:Bind IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Recommended" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CockpitOnAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{x:Bind MemoryText}"
                                           Style="{StaticResource HeroNumber}"
                                           FontSize="17"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind MemoryText, Converter={StaticResource NullToVisibilityConverter}}" />

                                <TextBlock Text="{x:Bind ProcessesText}"
                                           FontSize="12"
                                           Foreground="{StaticResource CockpitTextSecondary}"
                                           Visibility="{x:Bind ProcessesText, Converter={StaticResource NullToVisibilityConverter}}" />

                                <TextBlock Text="{x:Bind StopsText}"
                                           FontSize="12"
                                           Foreground="{StaticResource CockpitTextTertiary}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{x:Bind InUseText}"
                                           FontSize="12"
                                           Foreground="{StaticResource CockpitTextSecondary}"
                                           Visibility="{x:Bind InUseText, Converter={StaticResource NullToVisibilityConverter}}" />

                                <TextBlock Text="{x:Bind PartlyNote}"
                                           FontSize="12"
                                           Foreground="{StaticResource SystemFillColorCautionBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind PartlyNote, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
