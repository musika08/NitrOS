<Page
    x:Class="NitrOS.App.Pages.WorkingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24"
                    Spacing="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Applying changes..."
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ProgressBar Value="{x:Bind ViewModel.Percent, Mode=OneWay}"
                         Maximum="100"
                         Height="8"
                         CornerRadius="4" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Height="240">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Log, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           FontSize="12"
                                           Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Command="{x:Bind ViewModel.Cancel}"
                    HorizontalAlignment="Right"
                    MinWidth="120" />
        </StackPanel>
    </Grid>
</Page>
