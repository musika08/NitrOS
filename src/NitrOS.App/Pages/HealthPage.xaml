<Page
    x:Class="NitrOS.App.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24,20"
                    Spacing="14"
                    HorizontalAlignment="Center">

            <StackPanel Spacing="3" Margin="0,0,0,4">
                <TextBlock Text="System health check"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.AfterRestartLine, Mode=OneWay}"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.AfterRestartLine, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>

            <!-- Health items list -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:HealthRow">
                        <Border Margin="0,3"
                                Padding="14,10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppleCardCornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Visibility="{x:Bind Ok, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ApplePillCornerRadius}"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="OK"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </Border>
                                        <Border Visibility="{x:Bind Ok, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ApplePillCornerRadius}"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Needs attention"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Detail}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind Detail, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <TextBlock Text="{x:Bind LikelySwitchName}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind LikelySwitchName, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Undo change"
                                        Command="{x:Bind UndoLikely}"
                                        Visibility="{x:Bind UndoLikely, Converter={StaticResource NullToVisibilityConverter}}"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom action buttons -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                <Button Content="Check again"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.CheckAgain}"
                        MinWidth="110" />

                <Button Content="Back"
                        Command="{x:Bind ViewModel.Back}"
                        MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
