<Page
    x:Class="NitrOS.App.Pages.UndoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d"
    Background="{StaticResource CockpitWindowBrush}">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24"
                    Spacing="16"
                    HorizontalAlignment="Center">

            <TextBlock Text="Undo past changes"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <TextBlock Text="You can put individual switches back to their original state, or undo an entire run."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Folder Problem Warning -->
            <InfoBar IsOpen="{x:Bind ViewModel.FolderProblem, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Warning"
                     IsClosable="False"
                     Message="{x:Bind ViewModel.FolderProblem, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.FolderProblem, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Runs list -->
            <ItemsControl x:Name="RunsList" ItemsSource="{x:Bind ViewModel.Runs, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:RunSummary">
                        <Border Margin="0,6"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Undo run"
                                            Tag="{x:Bind}"
                                            Click="OnUndoRunClicked"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind Switches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="screens:SwitchSummary">
                                            <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Reason}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind Reason, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="Undo"
                                                        Tag="{x:Bind}"
                                                        Click="OnUndoSwitchClicked"
                                                        IsEnabled="{x:Bind CanUndo}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom action buttons -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                <Button Content="Restart now"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.Restart}"
                        Visibility="{x:Bind ViewModel.NeedsRestart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinWidth="120" />

                <Button Content="Back"
                        Command="{x:Bind ViewModel.Back}"
                        MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
