<Page
    x:Class="NitrOS.App.Pages.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="{StaticResource ContentColumnMaxWidth}"
                    Margin="24,20"
                    Spacing="14"
                    HorizontalAlignment="Center">

            <!-- Apple-style refined header -->
            <StackPanel Spacing="3" Margin="0,0,0,4">
                <TextBlock Text="Overview"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Manage tuning setups, device updates, and system health."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Banner for session warnings or drift findings -->
            <InfoBar IsOpen="{x:Bind ViewModel.Banner, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Warning"
                     IsClosable="False"
                     CornerRadius="{StaticResource AppleCardCornerRadius}"
                     Message="{x:Bind ViewModel.Banner, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Banner, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Apple-like compact grouped cards -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:StartEntry">
                        <Border Margin="0,3"
                                Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppleCardCornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind DisabledReason}"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{x:Bind DisabledReason, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Open"
                                        Command="{x:Bind Open}"
                                        IsEnabled="{x:Bind Enabled}"
                                        MinWidth="72"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
