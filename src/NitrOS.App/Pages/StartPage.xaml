<Page
    x:Class="NitrOS.App.Pages.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:screens="using:NitrOS.App.Logic.Screens"
    mc:Ignorable="d">

    <ScrollViewer XYFocusKeyboardNavigation="Enabled">
        <StackPanel MaxWidth="840"
                    Margin="28,24"
                    Spacing="16"
                    HorizontalAlignment="Center">

            <!-- Apple-style Hero Overview Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24,20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="NitrOS Performance Studio"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ready"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Fine-tune Windows latency, silence background telemetry, and update drivers with zero bloat."
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="44" Height="44"
                            CornerRadius="12"
                            Background="#007AFF"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                        <TextBlock Text="&#xE790;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Banner for session warnings or drift findings -->
            <InfoBar IsOpen="{x:Bind ViewModel.Banner, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Warning"
                     IsClosable="False"
                     CornerRadius="10"
                     Message="{x:Bind ViewModel.Banner, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.Banner, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Apple Bento Card Grid -->
            <TextBlock Text="Quick Actions"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,4,0,0" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="412" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="screens:StartEntry">
                        <Border Margin="0,4,8,4"
                                Padding="16,14"
                                MinHeight="96"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Open"
                                            Command="{x:Bind Open}"
                                            IsEnabled="{x:Bind Enabled}"
                                            MinWidth="68"
                                            MinHeight="28"
                                            CornerRadius="14"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind Description}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />

                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind DisabledReason}"
                                           FontSize="11"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{x:Bind DisabledReason, Converter={StaticResource NullToVisibilityConverter}}"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
