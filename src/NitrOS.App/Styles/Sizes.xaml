<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="ContentColumnMaxWidth">880</x:Double>
    <x:Double x:Key="ControlMinHeight">32</x:Double>
    <CornerRadius x:Key="AppleCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ApplePillCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="AppleControlCornerRadius">8</CornerRadius>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleControlCornerRadius}" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleControlCornerRadius}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</ResourceDictionary>
