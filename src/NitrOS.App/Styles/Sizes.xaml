<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="ContentColumnMaxWidth">960</x:Double>
    <x:Double x:Key="ControlMinHeight">40</x:Double>
    <CornerRadius x:Key="AppleCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ApplePillCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="AppleControlCornerRadius">10</CornerRadius>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleControlCornerRadius}" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleControlCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

</ResourceDictionary>
