<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>nitros</AssemblyName>
    <RootNamespace>NitrOS.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NitrOS.Core\NitrOS.Core.csproj" />
    <ProjectReference Include="..\NitrOS.Live\NitrOS.Live.csproj" />
    <ProjectReference Include="..\NitrOS.Image\NitrOS.Image.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
