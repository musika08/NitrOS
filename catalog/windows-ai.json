{
  "group": "windows-ai",
  "title": "Windows AI",
  "switches": [
    {
      "id": "copilot-remove", "name": "Remove Copilot", "feature": "Copilot",
      "description": "Removes the Copilot app and turns off Windows Copilot and its taskbar button.",
      "risk": "safe", "breaks": ["Copilot is gone from Windows."],
      "modes": ["live", "image"], "reversible": false,
      "cards": { "recommended": "on", "gamer": "on", "streamer": "on", "maxLean": "on" },
      "live": [
        { "type": "appx.remove", "name": "Microsoft.Copilot" },
        { "type": "registry.set", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "kind": "dword", "data": "1" },
        { "type": "registry.set", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowCopilotButton", "kind": "dword", "data": "0" }
      ],
      "image": [
        { "type": "appx.remove", "name": "Microsoft.Copilot" },
        { "type": "registry.set", "hive": "HKCU", "key": "Software\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "kind": "dword", "data": "1" },
        { "type": "registry.set", "hive": "HKCU", "key": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowCopilotButton", "kind": "dword", "data": "0" }
      ]
    },
    {
      "id": "recall-off", "name": "Turn off Recall", "feature": "Recall",
      "description": "Removes the Recall feature and blocks it with policy.",
      "risk": "safe", "breaks": ["Recall snapshots and search are gone."],
      "modes": ["live", "image"], "reversible": true,
      "cards": { "recommended": "on", "gamer": "on", "streamer": "on", "maxLean": "on" },
      "live": [
        { "type": "feature.disable", "name": "Recall" },
        { "type": "registry.set", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "AllowRecallEnablement", "kind": "dword", "data": "0" },
        { "type": "registry.set", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableAIDataAnalysis", "kind": "dword", "data": "1" },
        { "type": "task.disable", "path": "\\Microsoft\\Windows\\WindowsAI\\Recall\\InitialConfiguration" }
      ],
      "image": [
        { "type": "feature.disable", "name": "Recall" },
        { "type": "registry.set", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "AllowRecallEnablement", "kind": "dword", "data": "0" },
        { "type": "registry.set", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableAIDataAnalysis", "kind": "dword", "data": "1" },
        { "type": "task.disable", "path": "\\Microsoft\\Windows\\WindowsAI\\Recall\\InitialConfiguration" }
      ]
    },
