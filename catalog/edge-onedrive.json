{
  "group": "edge-onedrive",
  "title": "Edge and OneDrive",
  "switches": [
    {
      "id": "edge-remove", "name": "Remove Microsoft Edge", "feature": "Microsoft Edge",
      "description": "Uninstalls the Edge browser; the WebView2 runtime apps need stays.",
      "risk": "caution",
      "breaks": ["Microsoft Edge is gone; web links open in your other browser. A big Windows update may put Edge back. Copilot and Game Assist inside Edge go with it."],
      "modes": ["live", "image"], "reversible": false,
      "cards": { "recommended": "off", "gamer": "on", "streamer": "on", "maxLean": "on" },
      "live": [
        { "type": "program.uninstall", "displayName": "Microsoft Edge", "publisher": "Microsoft Corporation", "args": "--force-uninstall" },
        { "type": "appx.remove", "name": "Microsoft.MicrosoftEdge.Stable" },
        { "type": "registry.delete", "hive": "HKLM", "key": "SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge" },
        { "type": "registry.delete", "hive": "HKLM", "key": "SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge Update" }
      ],
      "image": [
        { "type": "file.remove", "path": "%ProgramFiles(x86)%\\Microsoft\\Edge" },
        { "type": "file.remove", "path": "%ProgramFiles(x86)%\\Microsoft\\EdgeUpdate" },
        { "type": "file.remove", "path": "%ProgramFiles(x86)%\\Microsoft\\EdgeCore" },
        { "type": "registry.delete", "hive": "HKLM", "key": "SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge" },
        { "type": "registry.delete", "hive": "HKLM", "key": "SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Microsoft Edge Update" }
      ]
    },
    {
      "id": "onedrive-remove", "name": "Remove OneDrive", "feature": "OneDrive",
      "description": "Uninstalls OneDrive and turns off its sync.",
      "risk": "caution",
      "breaks": ["Files kept only in OneDrive are not on this PC; get them at onedrive.com. Desktop or Documents folders backed up to OneDrive may look empty."],
      "modes": ["live", "image"], "reversible": false,
      "cards": { "recommended": "off", "gamer": "on", "streamer": "on", "maxLean": "on" },
      "live": [
        { "type": "program.uninstall", "displayName": "Microsoft OneDrive", "publisher": "Microsoft Corporation" },
        { "type": "appx.remove", "name": "Microsoft.OneDriveSync" },
        { "type": "registry.set", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive", "name": "DisableFileSyncNGSC", "kind": "dword", "data": "1" }
      ],
      "image": [
        { "type": "file.remove", "path": "%SystemRoot%\\System32\\OneDriveSetup.exe" },
        { "type": "appx.remove", "name": "Microsoft.OneDriveSync" },
        { "type": "registry.set", "hive": "HKLM", "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive", "name": "DisableFileSyncNGSC", "kind": "dword", "data": "1" }
      ]
    }
  ]
}
